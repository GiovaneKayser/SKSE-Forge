{
  "name": "skse-forge",
  "version": "1.0.0",
  "description": "Universal SKSE Plugin Modernizer for Skyrim SE/AE to CommonLibSSE-NG",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "cross-env ELECTRON_RUN_AS_NODE= vite",
    "build": "tsc && vite build",
    "test": "tsx test/test-services.ts && tsx test/test-pack.ts && tsx test/test-binary-compat.ts",
    "preview": "vite preview",
    "generate-icon": "node scripts/generate-icon.mjs",
    "dist:win": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:zip": "npm run build && electron-builder --win zip"
  },
  "build": {
    "appId": "com.giovanekayser.skseforge",
    "productName": "SKSE Forge",
    "copyright": "Copyright © 2026 Giovane Kayser",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/data/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/data",
        "to": "data",
        "filter": ["**/*"]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "SKSE-Forge-v${version}-win-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "SKSE-Forge-v${version}-Portable.exe"
    }
  },
  "keywords": [
    "skse",
    "skyrim",
    "commonlib-ng",
    "electron",
    "modding"
  ],
  "author": "Giovane Kayser & SKSE Forge Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GiovaneKayser/SKSE-Forge.git"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "i18next": "^24.2.2",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^26.18.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
